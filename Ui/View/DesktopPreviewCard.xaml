<UserControl x:Class="_1RM.Controls.DesktopPreviewCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Margin="0,0,12,12" VerticalAlignment="Top" UseLayoutRounding="True" FontFamily="Microsoft YaHei UI" Foreground="#24374A">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="5,3"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#D8E2EC"/>
   <Setter Property="Foreground" Value="#34516A"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E2EEFA"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Background="#FAFCFE" BorderBrush="#CAD8E5" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
  <StackPanel>
   <Grid Margin="10,8,10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="DeviceName" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="StateDot" Grid.Column="1" Text="●" FontSize="10" Margin="6,0,0,0" Foreground="#9DAEBD" ToolTip="未连接"/>
   </Grid>
   <Grid x:Name="PreviewArea" Height="152" Background="#DFEAF3" MouseLeftButtonUp="Preview_MouseLeftButtonUp" Cursor="Hand" ToolTip="单击进入桌面">
    <Image x:Name="PreviewImage" Stretch="Uniform"/>
    <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="▣" FontSize="30" Foreground="#8BA6BB" HorizontalAlignment="Center"/>
     <TextBlock x:Name="EmptyText" Text="连接后保留最后画面" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="#698296" Margin="4,7,4,0"/>
    </StackPanel>
   </Grid>
   <Grid Margin="8,7,8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Content="文件" Click="Files_Click" MaxWidth="52" HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip="Windows 文件共享"/>
    <Button Content="大图" Grid.Column="1" Click="Image_Click" MaxWidth="52" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
    <Button x:Name="More" Content="···" Grid.Column="2" Click="More_Click" Width="27" HorizontalAlignment="Right" ToolTip="更多：重启、关机、连接设置"/>
   </Grid>
   <TextBlock x:Name="Timestamp" FontSize="10" Foreground="#7E8F9F" Margin="9,0,9,7" Text="尚无预览" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
 </Border>
</UserControl>
