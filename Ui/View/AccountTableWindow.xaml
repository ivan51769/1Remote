<Window x:Class="_1RM.View.AccountTableWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="账号表" Width="1320" Height="760" MinWidth="900" MinHeight="460"
 WindowStartupLocation="CenterOwner" Background="#F2F6FA" Foreground="#24374A"
 FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#24374A"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal"><Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="3" Background="White" BorderBrush="#8CA7BE" BorderThickness="1" VerticalAlignment="Center">
     <TextBlock x:Name="CheckMark" Text="✓" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Border><ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#258BFF"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#258BFF"/><Setter TargetName="CheckSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24374A"/><Setter Property="BorderBrush" Value="#C8D7E4"/><Setter Property="CaretBrush" Value="#24374A"/><Setter Property="Padding" Value="5,3"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24374A"/><Setter Property="BorderBrush" Value="#C8D7E4"/><Setter Property="CaretBrush" Value="#24374A"/><Setter Property="Padding" Value="5,3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24374A"/><Setter Property="BorderBrush" Value="#C8D7E4"/><Setter Property="Padding" Value="5,3"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24374A"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24374A"/><Setter Property="BorderBrush" Value="#C8D7E4"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E5EEF6"/><Setter Property="Foreground" Value="#34516A"/><Setter Property="Padding" Value="9,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="BorderBrush" Value="#D4E0EA"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEEFF"/><Setter Property="Foreground" Value="#163D60"/><Setter Property="BorderBrush" Value="#67A8EB"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="#24374A"/><Style.Triggers><DataTrigger Binding="{Binding IsWritable}" Value="False"><Setter Property="Foreground" Value="#8493A1"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="7,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="账号表" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="HelpText" Text="双击单元格编辑；复制新增后修改账号，保存即同步到设备卡片。" Foreground="#687F93" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
   <TextBox x:Name="SearchBox" Grid.Column="1" Height="32" VerticalAlignment="Center" Padding="8,5" ToolTip="搜索设备、备注、地址、用户名" TextChanged="Search_Changed"/>
  </Grid>
  <WrapPanel x:Name="Toolbar" Grid.Row="1" Margin="0,0,0,12">
   <Button x:Name="UndoButton" Content="撤销" Click="Undo_Click" IsEnabled="False" ToolTip="撤销未保存的修改（Ctrl+Z）；保存后清空历史"/>
   <Button x:Name="RedoButton" Content="重做" Click="Redo_Click" IsEnabled="False" ToolTip="重做上次撤销（Ctrl+Y）"/>
   <Button Content="新增 RDP" Click="New_Click"/>
   <Button Content="复制新增" Click="Duplicate_Click" ToolTip="可选择多行，一次复制多个账号"/>
   <Button Content="移除草稿" Click="RemoveDraft_Click" ToolTip="只移除尚未保存的新行，不删除已有设备"/>
   <Button Content="导入 Excel" Click="Import_Click" ToolTip="导入为新行，检查后保存；不覆盖已有账号"/>
   <Button Content="导出 Excel" Click="Export_Click" ToolTip="导出当前筛选结果的常用账号字段；完整高级配置请使用原生 JSON 导出"/>
   <CheckBox x:Name="ExportPasswords" Content="导出含密码" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#34516A" ToolTip="勾选后 Excel 包含明文密码；默认不导出密码"/>
   <TextBlock Text="新增到" VerticalAlignment="Center" Margin="12,0,8,0"/>
   <ComboBox x:Name="SourcePicker" Width="150" Height="32" DisplayMemberPath="DataSourceName" VerticalContentAlignment="Center"/>
  </WrapPanel>
  <DataGrid x:Name="AccountsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
    SelectionMode="Extended" SelectionUnit="FullRow" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3EBF2"
    Background="White" AlternatingRowBackground="#F7FAFD" BorderBrush="#C8D7E4" BorderThickness="1" ClipboardCopyMode="None"
    BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding" EnableRowVirtualization="True" EnableColumnVirtualization="True">
   <DataGrid.Columns>
    <DataGridTextColumn Header="状态" Binding="{Binding State}" IsReadOnly="True" Width="75" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn x:Name="NameColumn" Header="设备名" SortMemberPath="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="190" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn x:Name="AliasColumn" Header="备注" SortMemberPath="Alias" Binding="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Width="95" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="IP / 地址" SortMemberPath="Address" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="155" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="端口" SortMemberPath="Port" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="用户名" SortMemberPath="UserName" Binding="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="145" ElementStyle="{StaticResource CellText}"/>
    <DataGridTemplateColumn Header="密码" SortMemberPath="Password" Width="105" CanUserSort="False">
     <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PasswordSummary}" Style="{StaticResource CellText}" ToolTip="双击可修改密码；凭据库和密钥请在连接设置中编辑"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
     <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><PasswordBox Padding="5,3" Loaded="Password_Loaded" PasswordChanged="Password_Changed" IsEnabled="{Binding CanEditPassword}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="域" SortMemberPath="Domain" Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="数据源" Binding="{Binding SourceName}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource CellText}"/>
   </DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#58728A" TextWrapping="Wrap" Margin="0,0,16,0"/>
   <Button x:Name="SaveButton" Grid.Column="1" Content="保存修改" Click="Save_Click" Background="#258BFF" Foreground="White" BorderBrush="#258BFF" MinWidth="100"/>
   <Button x:Name="CloseButton" Grid.Column="2" Content="关闭" Click="Close_Click" MinWidth="80" Margin="0"/>
  </Grid>
 </Grid>
</Window>
